# Chave de API da Google AI (Gemini)
# Obtenha gratuitamente em: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_aqui

# Configurações do Modelo
GEMINI_MODEL=gemini-3.6-flash

# Log de desenvolvimento (ADR 0019): erros inesperados com traceback, em arquivo texto rotativo.
# Nível (DEBUG, INFO, WARNING, ERROR) e pasta (vazio = data/logs).
LOG_LEVEL=INFO
MUSICMATCH_LOG_DIR=

# Caminho do Banco de Dados SQLite (Local)
DATABASE_PATH=data/musicmatch.db

# Onde o /library set-path grava a pasta escolhida para a Biblioteca Gerenciada (vazio = data/library_config.json)
MUSICMATCH_LIBRARY_CONFIG=

# Análise Acústica (ADR 0014)
# Executável do FFmpeg (vazio = procurar no PATH). Sem FFmpeg, apenas arquivos WAV são analisados.
MUSICMATCH_FFMPEG_PATH=
# Decodificadores paralelos do /analyze (0 = automático, até 4 conforme os núcleos da CPU)
MUSICMATCH_ANALYSIS_WORKERS=0

# Reprodução de Áudio (ADR 0015)
# Backend de saída (vazio = automático). Opções: wasapi, dsound, winmm, coreaudio, pulseaudio, alsa, jack, null
# Use "null" em servidores sem placa de som (a reprodução ocorre sem saída audível).
MUSICMATCH_AUDIO_BACKEND=

# Contagem de reproduções (ADR 0016): uma reprodução conta após ouvir este número de segundos
# da faixa (faixas mais curtas contam quando ouvidas até o fim).
MUSICMATCH_PLAY_COUNT_SECONDS=60

# Problemas (ADR 0019): problemas dispensados que não voltam a ocorrer por este número de dias
# são apagados ao iniciar o MusicMatch.
MUSICMATCH_ISSUE_RETENTION_DAYS=180
